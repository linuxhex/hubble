# 阿里云 SLS 配置（必填）
ALIYUN_SLS_ACCESS_KEY_ID=your-access-key-id
ALIYUN_SLS_ACCESS_KEY_SECRET=your-access-key-secret
ALIYUN_SLS_PROJECT=your-sls-project
ALIYUN_SLS_ENDPOINT=cn-hangzhou.log.aliyuncs.com

# ARMS 配置（可选，默认复用 SLS 凭证）
# ARMS_AK_ID=
# ARMS_AK_SECRET=
# ARMS_REGION=cn-hangzhou

# 钉钉配置（可选）
# DINGTALK_APP_KEY=
# DINGTALK_APP_SECRET=
# DINGTALK_REDIRECT_URL=http://localhost:8778/query

# JWT 配置（可选，有默认值）
# JWT_PUBLIC_KEY=CloudEyesJwtSecretKeyForHMACSHA256AlgorithmMustBeAtLeast32Bytes
# JWT_EXPIRATION=3600000

# Milvus 配置（可选，有默认值）
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# MILVUS_USERNAME=root
# MILVUS_PASSWORD=milvus_password
# MILVUS_DATABASE=devops

# DashScope 配置（可选）
# DASHSCOPE_API_KEY=your-dashscope-api-key
